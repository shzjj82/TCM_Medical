# ---------- 服务端 ----------
# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=tcm_medical
DB_SYNCHRONIZE=true
DB_SSL=false

# NestJS
PORT=3001
JWT_SECRET=change-me

# ---------- AI Provider（DeepSeek，OpenAI 兼容协议）----------
# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选：默认官方地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 推理模型（用于医案总结 / 教学文档生成），留空则回落到 DEEPSEEK_MODEL
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---------- 多模态（可选：语音转写 / 图片 OCR）----------
# 说明：DeepSeek 当前不具备 ASR 与视觉能力，语音与图片解析走独立 Provider，
# 未配置时 Skill 会自动降级为「纯文本」模式，不影响主流程。
ASR_PROVIDER=none            # none | openai | whisper_local
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1

VISION_PROVIDER=none         # none | openai
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# ---------- Skill 运行时 ----------
# Skill 本地资料库根目录（JSON 文件存储，便于 Git 沉淀与离线使用）
TCM_SKILL_DATA_DIR=skills/tcm-medical-case/data
# Skill 归档目录：病例、报告、教学文档输出位置
TCM_SKILL_OUTPUT_DIR=skills/tcm-medical-case/output
# 服务端 API（用于把本地沉淀同步到 Postgres）
TCM_API_BASE_URL=http://localhost:3001
TCM_API_TOKEN=

# ---------- 前端 ----------
VITE_API_BASE_URL=http://localhost:3001
