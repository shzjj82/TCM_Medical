# ---------- 服务端 ----------
# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=tcm_medical
DB_SYNCHRONIZE=true
DB_SSL=false

# NestJS
PORT=3001
JWT_SECRET=change-me

# ---------- AI Provider（阿里云通义百炼，OpenAI 兼容协议）----------
# 必填：DashScope API Key（https://bailian.console.aliyun.com/ 开通后获取）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选：默认 DashScope 兼容模式地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 推理模型（用于医案总结 / 教学文档 / 治疗建议综合），留空则回落到 LLM_MODEL
LLM_REASONER_MODEL=qwen-max
# 旧配置兼容：DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL 仍可读，优先级低于 LLM_*

# ---------- 语音（通义百炼 ASR）----------
# realtime：Paraformer 实时语音识别（服务端 WebSocket 代理，浏览器直连会暴露 Key）
# tingwu：通义听悟，上传录音文件的离线转写（异步任务）
ASR_PROVIDER=none            # none | realtime | tingwu | openai | whisper_local
ASR_API_KEY=                 # 默认回落到 LLM_API_KEY
ASR_BASE_URL=
ASR_MODEL=paraformer-v2

VISION_PROVIDER=none         # none | openai
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# ---------- Skill 运行时 ----------
# Skill 本地资料库根目录（JSON 文件存储，便于 Git 沉淀与离线使用）
TCM_SKILL_DATA_DIR=skills/tcm-medical-case/data
# Skill 归档目录：病例、报告、教学文档输出位置
TCM_SKILL_OUTPUT_DIR=skills/tcm-medical-case/output
# 服务端 API（用于把本地沉淀同步到 Postgres）
TCM_API_BASE_URL=http://localhost:3001
TCM_API_TOKEN=

# ---------- 前端 ----------
VITE_API_BASE_URL=http://localhost:3001
